# Runtime
RAG_ENVIRONMENT=dev
RAG_LOG_LEVEL=INFO

# Embeddings: deterministic and offline by default. Install `.[ml]` and set this
# to 0 to use RAG_EMBEDDING_MODEL_NAME instead.
RAG_FAKE_EMBEDDINGS=1
RAG_FAKE_EMBEDDING_DIM=64
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage: leave RAG_QDRANT_URL unset for the in-memory Qdrant client.
RAG_VECTOR_BACKEND=qdrant
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=replace-with-a-qdrant-secret
RAG_QDRANT_COLLECTION=rag_documents
# RAG_POSTGRES_URL=postgresql://rag:rag@localhost:5432/rag
RAG_PGVECTOR_TABLE=rag_documents

# Retrieval and reciprocal-rank fusion
RAG_RETRIEVAL_STRATEGY=hybrid
RAG_TOP_K=5
RAG_CANDIDATE_MULTIPLIER=4
RAG_RRF_K=60
RAG_RRF_LEXICAL_WEIGHT=0.65
RAG_MIN_RELEVANCE_SCORE=0.40
RAG_LEXICAL_SCAN_LIMIT=1000

# Ingestion and request limits
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_REQUEST_SIZE_LIMIT_MB=5
RAG_MAX_FILENAME_CHARS=255
RAG_MAX_PDF_PAGES=50
RAG_MAX_DOCUMENT_CHARS=2000000
RAG_MAX_DOCUMENT_CHUNKS=2000
RAG_RATE_LIMIT_PER_MINUTE=60

# Optional: when set, clients must send this value in X-API-Key to /ingest.
# RAG_INGEST_API_KEY=replace-with-a-secret
